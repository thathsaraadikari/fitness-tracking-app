<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/ic_menu_compass"
        android:label="@string/app_name"
        android:roundIcon="@android:drawable/ic_menu_compass"
        android:supportsRtl="true"
        android:theme="@style/Theme.FitnessTracker">

        <!--
            Task affinity simulation:
            WorkoutActivity keeps the app's default task affinity.
            SummaryActivity uses a different task affinity, so launching it with suitable intent
            flags can create/move it to another task and change recents/back-stack behavior.
        -->
        <activity
            android:name=".SummaryActivity"
            android:exported="false"
            android:taskAffinity="com.example.fitnesstracker.summary_task"
            android:allowTaskReparenting="true" />

        <activity
            android:name=".WorkoutActivity"
            android:exported="false" />

        <activity
            android:name=".HomeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
